{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "idhair.com" }],
      "destination": "https://www.idhair.com/$1",
      "statusCode": 301
    },
    { "source": "/shop", "destination": "/salon", "statusCode": 301 },
    { "source": "/shop/(.*)", "destination": "/salon", "statusCode": 301 },
    {
      "source": "/bbs/(link|board).php",
      "has": [{ "type": "query", "key": "bo_table", "value": "salon" }],
      "destination": "/salon",
      "statusCode": 301
    },
    {
      "source": "/bbs/board.php",
      "has": [{ "type": "query", "key": "bo_table", "value": "news" }],
      "destination": "/magazine/id-news",
      "statusCode": 301
    },
    { "source": "/bbs/(.*)", "destination": "/", "statusCode": 301 },
    { "source": "/recruit", "destination": "/careers", "statusCode": 301 },
    { "source": "/recruit/(.*)", "destination": "/careers", "statusCode": 301 },
    { "source": "/en/recruit", "destination": "/en/careers", "statusCode": 301 },
    { "source": "/en/recruit/(.*)", "destination": "/en/careers", "statusCode": 301 },
    { "source": "/file/2021recurit.doc", "destination": "/careers", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/en/about", "destination": "/en/about/index.html" },
    { "source": "/academy", "destination": "/academy/index.html" },
    { "source": "/careers", "destination": "/careers/index.html" },
    { "source": "/en/careers", "destination": "/en/careers/index.html" },
    { "source": "/magazine", "destination": "/magazine/index.html" },
    { "source": "/magazine/our-picks", "destination": "/magazine/our-picks/index.html" },
    { "source": "/magazine/id-news", "destination": "/magazine/id-news/index.html" },
    { "source": "/magazine/id-event", "destination": "/magazine/id-event/index.html" },
    { "source": "/magazine/id-family", "destination": "/magazine/id-family/index.html" },
    { "source": "/magazine/id-gallery", "destination": "/magazine/id-gallery/index.html" },
    { "source": "/magazine/id-play", "destination": "/magazine/id-play/index.html" },
    {
      "source": "/sanity-data/(.*)",
      "destination": "https://9pry8zdk.api.sanity.io/v2025-02-19/data/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
